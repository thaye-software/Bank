{
  "name": "nordicbank",
  "version": "1.0.0",
  "private": true,
  "description": "NordicBank — Software Quality Exam Project",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "cd client && vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",

    "build:server": "tsc --project tsconfig.json",
    "build:client": "cd client && vite build",
    "build": "npm run build:server && npm run build:client",
  
    "start": "node dist/server.js",

    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",

    "test": "vitest run --config vitest.config.ts && playwright test",

    "test:unit": "vitest run --config vitest.config.ts",

    "test:integration": "vitest run --config vitest.integration.config.ts && npx playwright test --project=api-integration",

    "test:api": "playwright test --project=api-integration",

    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox --project=e2e-webkit",
    "test:e2e:headed": "playwright test --project=e2e-chromium --headed",
    "test:e2e:ui": "playwright test --project=e2e-chromium --ui",
    "test:e2e:debug": "playwright test --project=e2e-chromium --debug",

    "test:coverage": "vitest run --config vitest.config.ts --coverage",

    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.2.0",
    "@playwright/test": "^1.48.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.2",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vitest": "^0.5.4",
    "msw": "^2.4.10",
    "pino-pretty": "^11.2.2",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
