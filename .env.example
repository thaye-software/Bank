# Copy to .env and fill in values — never commit .env

# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://nordicbank:nordicbank@localhost:5432/nordicbank"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/nordicbank_test"

# Auth
JWT_SECRET="replace-with-a-long-random-secret-at-least-64-chars"
JWT_EXPIRES_IN="7d"

# External APIs
CURRENCY_API_KEY="your-currencyapi-com-key"

# Feature flags (never true in production)
ENABLE_KYC_AUTO_APPROVE=false
