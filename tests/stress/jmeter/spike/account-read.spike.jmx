      <hashTree/>
      <kg.apc.jmeter.threads.UltimateThreadGroup guiclass="kg.apc.jmeter.threads.UltimateThreadGroupGui" testclass="kg.apc.jmeter.threads.UltimateThreadGroup" testname="Ultimate Thread Group — 455 → 1300 → 455 (13:30)">
        <collectionProp name="ultimatethreadgroupdata">
          <collectionProp name="row-baseline-455">
            <stringProp name="utg-r1-threads">455</stringProp>
            <stringProp name="utg-r1-delay">0</stringProp>
            <stringProp name="utg-r1-startup">10</stringProp>
            <stringProp name="utg-r1-hold">790</stringProp>
            <stringProp name="utg-r1-shutdown">10</stringProp>
